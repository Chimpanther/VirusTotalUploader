      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\uploader\Utils.cs" Link="Utils.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\uploader\Settings.cs" Link="Settings.cs" />
